#!/usr/bin/env bash
# Start backend (Uvicorn :8000) and frontend (Vite :5173) together.
# Usage: from repo root — ./scripts/stepup

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VENV_PY="$ROOT/.venv/bin/python"

BACKEND_PID=""
FRONTEND_PID=""

cleanup() {
  if [[ -n "$BACKEND_PID" ]] && kill -0 "$BACKEND_PID" 2>/dev/null; then
    kill "$BACKEND_PID" 2>/dev/null || true
  fi
  if [[ -n "$FRONTEND_PID" ]] && kill -0 "$FRONTEND_PID" 2>/dev/null; then
    kill "$FRONTEND_PID" 2>/dev/null || true
  fi
}

trap cleanup INT TERM EXIT

if [[ ! -x "$VENV_PY" ]]; then
  echo "Missing venv Python at $VENV_PY" >&2
  echo "Create and install deps: python3 -m venv .venv && .venv/bin/pip install -e \"backend[dev]\"" >&2
  exit 1
fi

if ! command -v npm >/dev/null 2>&1; then
  echo "npm not found; install Node.js first." >&2
  exit 1
fi

echo "Starting backend → http://0.0.0.0:8000"
(
  cd "$ROOT/backend"
  exec "$VENV_PY" -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000
) &
BACKEND_PID=$!

echo "Starting frontend → http://localhost:5173 (see Vite output for exact URL)"
(
  cd "$ROOT/frontend"
  exec npm run dev
) &
FRONTEND_PID=$!

wait "$BACKEND_PID" "$FRONTEND_PID"
