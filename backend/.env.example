# Copy to .env and adjust. Pydantic reads DATABASE_URL (and other vars) from the environment.

# Default: PostgreSQL (e.g. Docker: deploy/docker-compose.yml)
# DATABASE_URL=postgresql+asyncpg://llmine:llmine@localhost:5432/llmine

# No Docker / quick local API: file-backed SQLite (from backend/ directory)
DATABASE_URL=sqlite+aiosqlite:///./dev.db

REDIS_URL=redis://localhost:6379/0
SECRET_KEY=dev-secret-key-change-in-production
